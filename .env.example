# VERIFIND AI — copy to `.env` and fill values. NEVER commit `.env`.
#   make env
# Full step-by-step guide (every secret): docs/ENV_SETUP.md
#
# Where to get each value (official links):
#   Supabase project:     https://supabase.com/dashboard
#   Supabase API keys:    https://supabase.com/dashboard/project/_/settings/api
#   Supabase DB / pooler: https://supabase.com/dashboard/project/_/settings/database
#                         (Connect → Connection string → Transaction pooler → port 6543)
#   Supabase JWT secret:  https://supabase.com/dashboard/project/_/settings/api
#                         (JWT Settings → JWT Secret)
#   Storage buckets:      https://supabase.com/dashboard/project/_/storage/buckets
#                         (or: make ensure-buckets)
#   OpenAI API key:       https://platform.openai.com/api-keys
#   OpenRouter (optional): https://openrouter.ai/keys
#   Groq (optional):      https://console.groq.com/keys
#   Anthropic (optional): https://console.anthropic.com/settings/keys
#   Google AI (optional): https://aistudio.google.com/apikey
#   Langfuse (optional):  https://cloud.langfuse.com  → Project → Settings → API Keys
#   Redis (local):        docker compose redis, or https://redis.io/docs/latest/operate/oss_and_stack/install/install-redis/
#   Docker Desktop:       https://docs.docker.com/desktop/

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
# Admin SPA + any fixed origins. Flutter web (Chrome) random ports are allowed
# automatically via localhost/127.0.0.1 regex in the API — no need to list them.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------------------------------------------------------------------------
# Supabase — https://supabase.com/dashboard
# ---------------------------------------------------------------------------
# Project URL → Settings → API → Project URL
SUPABASE_URL=https://your-project.supabase.co
# Settings → API → Project API keys → anon public
SUPABASE_ANON_KEY=replace-me
# Settings → API → Project API keys → service_role (server only — never ship to Flutter)
SUPABASE_SERVICE_KEY=replace-me
# Settings → API → JWT Settings → JWT Secret
# JWT verification (pick one path — JWKS works without revealing a secret):
# New UI: Project Settings → JWT Keys
#   https://supabase.com/dashboard/project/_/settings/jwt
# Docs: https://supabase.com/docs/guides/auth/signing-keys
# - Legacy JWT secret → paste below as SUPABASE_JWT_SECRET
# - Or leave secret empty / wrong: API verifies via JWKS using SUPABASE_URL
SUPABASE_JWT_SECRET=replace-me
# Settings → Database → Connect → Transaction pooler (port 6543), NOT 5432
# Docs: https://supabase.com/docs/guides/database/connecting-to-postgres#supabase-connection-pooler
# Local-only Postgres (optional): postgresql://postgres:postgres@localhost:5432/verifind
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Storage bucket names (create in dashboard or: make ensure-buckets)
# https://supabase.com/dashboard/project/_/storage/buckets
STORAGE_PUBLIC_BUCKET=public-sanitized
STORAGE_VAULT_BUCKET=private-vault

# ---------------------------------------------------------------------------
# Redis / Arq — local compose uses localhost; inside containers use host "redis"
# Redis docs: https://redis.io/docs/latest/operate/oss_and_stack/install/install-redis/
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
ARQ_WORKER_ENABLED=false

# ---------------------------------------------------------------------------
# LLM providers — Sprint 1 soft-attach; OpenAI enough for later dual pipeline
# ---------------------------------------------------------------------------
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-replace-me
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# https://console.groq.com/keys
GROQ_API_KEY=
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# ---------------------------------------------------------------------------
# Observability (optional Sprint 1)
# https://cloud.langfuse.com → Project Settings → API Keys
# Docs: https://langfuse.com/docs/get-started
# ---------------------------------------------------------------------------
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Auth — local Sprint 1 smoke without real Supabase JWT
# Set AUTH_DEV_BYPASS=false once SUPABASE_* keys are real and you test login
# ---------------------------------------------------------------------------
AUTH_DEV_BYPASS=true
AUTH_DEV_USER_ID=00000000-0000-0000-0000-000000000001
AUTH_DEV_EMAIL=dev@verifind.local
# Sprint 6 admin SPA — role used when AUTH_DEV_BYPASS=true
AUTH_DEV_ROLE=admin
# Optional: deep-link / web URL after email verify or password reset
# Must also be listed under Supabase → Authentication → URL Configuration → Redirect URLs
AUTH_REDIRECT_URL=
