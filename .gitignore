!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.idea/
*.iws
*.iml
*.ipr
.fleet/

# Local reference clones — do not commit
Examples/


# Graphify AST cache (regenerable)
graphify-out/


